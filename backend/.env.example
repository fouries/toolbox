# 小巧的工具箱配置文件
# 复制此文件为 .env，然后修改配置

# 天行数据 API Key (在 https://www.tianapi.com 注册获取)
TIANAPI_KEY=your_tianapi_key_here

# Redis 配置（用于缓存，降低API调用成本）
# 如果没有Redis，注释此行，将不使用缓存
REDIS_URL=redis://localhost:6379/0

# 缓存时间（秒）
CACHE_TTL_OIL=43200
CACHE_TTL_WEATHER=10800
CACHE_TTL_DEFAULT=300

# 微信小程序订阅消息配置（AppSecret 只放 .env/环境变量，不要提交真实值）
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_SUBSCRIBE_ENABLED=true
WECHAT_SUBSCRIBE_TEMPLATE_DAILY_BRIEF=
WECHAT_SUBSCRIBE_TEMPLATE_WEATHER=
WECHAT_SUBSCRIBE_TEMPLATE_HOT_SEARCH=
WECHAT_SUBSCRIBE_TEMPLATE_GOLD_PRICE=
# 默认模板字段：事项 thing1、提醒时间 time2、备注 thing3；按微信后台模板字段调整
WECHAT_SUBSCRIBE_TEMPLATE_DATA_KEYS=thing1,time2,thing3

# 服务器配置
HOST=0.0.0.0
PORT=8000
