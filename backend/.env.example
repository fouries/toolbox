# 小巧的工具箱配置文件
# 复制此文件为 .env，然后修改配置

# 天行数据 API Key (在 https://www.tianapi.com 注册获取)
TIANAPI_KEY=your_tianapi_key_here

# Redis 配置（用于缓存，降低API调用成本）
# 如果没有Redis，注释此行，将不使用缓存
REDIS_URL=redis://localhost:6379/0

# 缓存时间（秒）
CACHE_TTL_OIL=43200
CACHE_TTL_WEATHER=10800
CACHE_TTL_DEFAULT=300

# 服务器配置
HOST=0.0.0.0
PORT=8000
