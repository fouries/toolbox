:root{--color-primary: #007aff;--color-primary-deep: #1677ff;--color-primary-light: #eef5ff;--color-success: #4ecdc4;--color-warning: #ffb74d;--color-danger: #ff6b6b;--color-purple: #a29bfe;--color-yellow: #fdcb6e;--color-bg: #f5f5f5;--color-bg-card: #ffffff;--color-text: #243044;--color-text-secondary: #7a869a;--color-text-muted: #9aa6b8;--color-border: #eef2f7;--color-alt-bg: #f6f8fb;--shadow-card: 0 4rpx 12rpx rgba(0, 0, 0, .05);--shadow-card-hover: 0 10rpx 26rpx rgba(20, 35, 90, .06);--radius-sm: 16rpx;--radius-md: 20rpx;--radius-lg: 30rpx;--radius-round: 999rpx}page{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Oxygen,Ubuntu,Cantarell,Fira Sans,Droid Sans,Helvetica Neue,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;background-color:var(--color-bg);color:var(--color-text)}button{border:none;outline:none}button:after{border:none}::-webkit-scrollbar{width:0;height:0;color:transparent}.page-shell{width:100%;max-width:960px;margin:0 auto}.page-header{text-align:center;margin-bottom:40rpx}.page-header .title{display:block;font-size:40rpx;font-weight:700;color:var(--color-text);margin-bottom:10rpx}.page-header .subtitle{font-size:24rpx;color:var(--color-text-muted)}.text-center{text-align:center}.text-left{text-align:left}.text-right{text-align:right}.flex{display:flex}.flex-center{display:flex;align-items:center;justify-content:center}.flex-between{display:flex;align-items:center;justify-content:space-between}.flex-column{display:flex;flex-direction:column}.m-10{margin:10rpx}.m-20{margin:20rpx}.p-10{padding:10rpx}.p-20{padding:20rpx}.p-30{padding:30rpx}.radius-8{border-radius:var(--radius-sm)}.radius-12{border-radius:var(--radius-md)}.shadow{box-shadow:var(--shadow-card)}.card{background:var(--color-bg-card);border-radius:var(--radius-md);padding:30rpx;margin-bottom:24rpx;box-shadow:var(--shadow-card)}.btn-primary{background:var(--color-primary);color:#fff;border-radius:var(--radius-round);padding:20rpx 40rpx;font-size:28rpx}.btn-primary:active{opacity:.8}.btn-primary[disabled]{background:#ccc}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}