<view class="container data-v-1d568e79"><view class="page-shell data-v-1d568e79"><view class="page-header data-v-1d568e79"><text class="title data-v-1d568e79">🌤️ 天气预报</text><text class="subtitle data-v-1d568e79">输入城市名称，查看实时天气和7天预报</text></view><view class="search-section data-v-1d568e79"><view class="search-box data-v-1d568e79"><input placeholder="输入城市名称（如：北京、上海）" class="search-input data-v-1d568e79" confirm-type="search" bindconfirm="{{a}}" value="{{b}}" bindinput="{{c}}"/><button class="search-btn data-v-1d568e79" bindtap="{{d}}" disabled="{{e}}">查询</button></view><view class="hot-cities data-v-1d568e79"><text class="hot-label data-v-1d568e79">热门城市:</text><view class="city-tags data-v-1d568e79"><text wx:for="{{f}}" wx:for-item="c" wx:key="b" class="{{['city-tag', 'data-v-1d568e79', c.c && 'active']}}" bindtap="{{c.d}}">{{c.a}}</text></view></view></view><view wx:if="{{g}}" class="loading data-v-1d568e79"><text class="loading-text data-v-1d568e79">加载中...</text></view><view wx:elif="{{h}}" class="weather-card data-v-1d568e79"><view class="weather-main data-v-1d568e79"><view class="city-info data-v-1d568e79"><text class="city-name data-v-1d568e79">{{i}}</text><text class="update-time data-v-1d568e79">{{j}} {{k}}</text></view><view class="weather-icon data-v-1d568e79"><text class="temp data-v-1d568e79">{{l}}</text><text class="weather data-v-1d568e79">{{m}}</text></view></view><view class="weather-details data-v-1d568e79"><view class="detail-item data-v-1d568e79"><text class="detail-label data-v-1d568e79">🌡️ 温度范围</text><text class="detail-value data-v-1d568e79">{{n}} ~ {{o}}</text></view><view class="detail-item data-v-1d568e79"><text class="detail-label data-v-1d568e79">💨 风向风力</text><text class="detail-value data-v-1d568e79">{{p}} {{q}}</text></view><view class="detail-item data-v-1d568e79"><text class="detail-label data-v-1d568e79">💧 湿度</text><text class="detail-value data-v-1d568e79">{{r}}%</text></view><view class="detail-item data-v-1d568e79"><text class="detail-label data-v-1d568e79">🌅 日出</text><text class="detail-value data-v-1d568e79">{{s}}</text></view><view class="detail-item data-v-1d568e79"><text class="detail-label data-v-1d568e79">🌇 日落</text><text class="detail-value data-v-1d568e79">{{t}}</text></view><view class="detail-item data-v-1d568e79"><text class="detail-label data-v-1d568e79">☀️ 紫外线</text><text class="detail-value data-v-1d568e79">{{v}}</text></view></view><view wx:if="{{w}}" class="forecast-section data-v-1d568e79"><text class="forecast-title data-v-1d568e79">📆 未来7天预报</text><scroll-view class="forecast-scroll data-v-1d568e79" scroll-x="true" show-scrollbar="false"><view class="forecast-list data-v-1d568e79"><view wx:for="{{x}}" wx:for-item="item" wx:key="g" class="forecast-item data-v-1d568e79"><text class="forecast-date data-v-1d568e79">{{item.a}}</text><text class="forecast-week data-v-1d568e79">{{item.b}}</text><text class="forecast-icon data-v-1d568e79">{{item.c}}</text><text class="forecast-weather data-v-1d568e79">{{item.d}}</text><text class="forecast-temp data-v-1d568e79">{{item.e}} ~ {{item.f}}</text></view></view></scroll-view></view><view wx:if="{{y}}" class="tips-card data-v-1d568e79"><text class="tips-title data-v-1d568e79">💡 生活提示</text><text class="tips-content data-v-1d568e79">{{z}}</text></view></view><view wx:elif="{{A}}" class="error-box data-v-1d568e79"><text class="error-text data-v-1d568e79">{{B}}</text><button class="retry-btn data-v-1d568e79" bindtap="{{C}}">重新查询</button></view><view wx:else class="placeholder data-v-1d568e79"><text class="placeholder-icon data-v-1d568e79">🌤️</text><text class="placeholder-text data-v-1d568e79">输入城市名称查询天气</text></view></view></view>