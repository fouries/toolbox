<view class="container data-v-03e8029b"><view class="search-section data-v-03e8029b"><view class="search-box data-v-03e8029b"><input placeholder="输入城市名称（如：北京、上海）" class="search-input data-v-03e8029b" bindconfirm="{{a}}" value="{{b}}" bindinput="{{c}}"/><button class="search-btn data-v-03e8029b" bindtap="{{d}}">查询</button></view><view class="hot-cities data-v-03e8029b"><text class="hot-label data-v-03e8029b">热门城市:</text><view class="city-tags data-v-03e8029b"><text wx:for="{{e}}" wx:for-item="c" wx:key="b" class="{{['city-tag', 'data-v-03e8029b', c.c && 'active']}}" bindtap="{{c.d}}">{{c.a}}</text></view></view></view><view wx:if="{{f}}" class="loading data-v-03e8029b"><text class="data-v-03e8029b">加载中...</text></view><view wx:elif="{{g}}" class="weather-card data-v-03e8029b"><view class="weather-main data-v-03e8029b"><view class="city-info data-v-03e8029b"><text class="city-name data-v-03e8029b">{{h}}</text><text class="update-time data-v-03e8029b">{{i}} {{j}}</text></view><view class="weather-icon data-v-03e8029b"><text class="temp data-v-03e8029b">{{k}}</text><text class="weather data-v-03e8029b">{{l}}</text></view></view><view class="weather-details data-v-03e8029b"><view class="detail-item data-v-03e8029b"><text class="detail-label data-v-03e8029b">🌡️ 温度范围</text><text class="detail-value data-v-03e8029b">{{m}} ~ {{n}}</text></view><view class="detail-item data-v-03e8029b"><text class="detail-label data-v-03e8029b">💨 风向风力</text><text class="detail-value data-v-03e8029b">{{o}} {{p}}</text></view><view class="detail-item data-v-03e8029b"><text class="detail-label data-v-03e8029b">💧 湿度</text><text class="detail-value data-v-03e8029b">{{q}}%</text></view><view class="detail-item data-v-03e8029b"><text class="detail-label data-v-03e8029b">🌅 日出</text><text class="detail-value data-v-03e8029b">{{r}}</text></view><view class="detail-item data-v-03e8029b"><text class="detail-label data-v-03e8029b">🌇 日落</text><text class="detail-value data-v-03e8029b">{{s}}</text></view><view class="detail-item data-v-03e8029b"><text class="detail-label data-v-03e8029b">☀️ 紫外线</text><text class="detail-value data-v-03e8029b">{{t}}</text></view></view><view wx:if="{{v}}" class="forecast-section data-v-03e8029b"><text class="forecast-title data-v-03e8029b">📆 未来7天预报</text><scroll-view class="forecast-scroll data-v-03e8029b" scroll-x="true" show-scrollbar="false"><view class="forecast-list data-v-03e8029b"><view wx:for="{{w}}" wx:for-item="item" wx:key="g" class="forecast-item data-v-03e8029b"><text class="forecast-date data-v-03e8029b">{{item.a}}</text><text class="forecast-week data-v-03e8029b">{{item.b}}</text><text class="forecast-icon data-v-03e8029b">{{item.c}}</text><text class="forecast-weather data-v-03e8029b">{{item.d}}</text><text class="forecast-temp data-v-03e8029b">{{item.e}} ~ {{item.f}}</text></view></view></scroll-view></view><view wx:if="{{x}}" class="tips-card data-v-03e8029b"><text class="tips-title data-v-03e8029b">💡 生活提示</text><text class="tips-content data-v-03e8029b">{{y}}</text></view></view><view wx:elif="{{z}}" class="error data-v-03e8029b"><text class="data-v-03e8029b">{{A}}</text></view><view wx:else class="placeholder data-v-03e8029b"><text class="placeholder-icon data-v-03e8029b">🌤️</text><text class="placeholder-text data-v-03e8029b">输入城市名称查询天气</text></view></view>