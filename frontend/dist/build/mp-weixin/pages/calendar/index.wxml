-v-ff99343a">农历 {{m}}{{n}} · {{o}}</text></view><view class="zodiac-badge data-v-ff99343a"><text class="data-v-ff99343a">{{p}}</text></view></view><view class="meta-grid data-v-ff99343a"><view class="meta-item data-v-ff99343a"><text class="meta-label data-v-ff99343a">年柱</text><text class="meta-value data-v-ff99343a">{{q}}</text></view><view class="meta-item data-v-ff99343a"><text class="meta-label data-v-ff99343a">月柱</text><text class="meta-value data-v-ff99343a">{{r}}</text></view><view class="meta-item data-v-ff99343a"><text class="meta-label data-v-ff99343a">日柱</text><text class="meta-value data-v-ff99343a">{{s}}</text></view></view><view wx:if="{{t}}" class="festival-line data-v-ff99343a"><text wx:if="{{v}}" class="festival-tag data-v-ff99343a">{{w}}</text><text wx:if="{{x}}" class="festival-tag term data-v-ff99343a">{{y}}</text></view><view class="almanac-grid data-v-ff99343a"><view class="almanac-panel suit-panel data-v-ff99343a"><view class="almanac-title data-v-ff99343a"><text class="circle good data-v-ff99343a">宜</text><text class="data-v-ff99343a">适合做</text></view><view class="tag-list data-v-ff99343a"><text wx:for="{{z}}" wx:for-item="item" wx:key="b" class="almanac-tag good-tag data-v-ff99343a">{{item.a}}</text></view></view><view class="almanac-panel avoid-panel data-v-ff99343a"><view class="almanac-title data-v-ff99343a"><text class="circle bad data-v-ff99343a">忌</text><text class="data-v-ff99343a">尽量避开</text></view><view class="tag-list data-v-ff99343a"><text wx:for="{{A}}" wx:for-item="item" wx:key="b" class="almanac-tag bad-tag data-v-ff99343a">{{item.a}}</text></view></view></view></view><view class="note-card card data-v-ff99343a"><text class="note-title data-v-ff99343a">温馨提示</text><text class="note-text data-v-ff99343a">黄历宜忌基于传统民俗算法生成，仅供生活参考；重要事项请结合实际情况安排。</text></view></view></view>