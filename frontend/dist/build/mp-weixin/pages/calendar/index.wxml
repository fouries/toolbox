<view class="{{['data-v-a467cead', 'container', B]}}"><view class="page-shell calendar-shell data-v-a467cead"><view class="page-header calendar-header data-v-a467cead"><text class="title data-v-a467cead">📅 黄历日历</text><text class="subtitle data-v-a467cead">查看公历、农历、节气和每日宜忌</text></view><view class="calendar-card card data-v-a467cead"><view class="calendar-toolbar data-v-a467cead"><button class="month-btn data-v-a467cead" size="mini" bindtap="{{a}}">‹ 上月</button><picker class="data-v-a467cead" mode="date" value="{{d}}" bindchange="{{e}}"><view class="date-picker data-v-a467cead"><text class="current-month data-v-a467cead">{{b}}年{{c}}月</text><text class="picker-hint data-v-a467cead">点击选择日期</text></view></picker><button class="month-btn data-v-a467cead" size="mini" bindtap="{{f}}">下月 ›</button></view><view class="week-row data-v-a467cead"><text wx:for="{{g}}" wx:for-item="week" wx:key="b" class="week-cell data-v-a467cead">{{week.a}}</text></view><view class="month-grid data-v-a467cead"><view wx:for="{{h}}" wx:for-item="day" wx:key="c" class="{{['day-cell', 'data-v-a467cead', day.d && 'muted', day.e && 'today', day.f && 'selected', day.g && 'festival']}}" bindtap="{{day.h}}"><text class="solar-day data-v-a467cead">{{day.a}}</text><text class="lunar-day data-v-a467cead">{{day.b}}</text></view></view><button class="today-btn data-v-a467cead" size="mini" bindtap="{{i}}">回到今天</button></view><view class="history-entry-card data-v-a467cead" bindtap="{{j}}"><view class="history-entry-icon data-v-a467cead">📜</view><view class="history-entry-content data-v-a467cead"><text class="history-entry-title data-v-a467cead">历史上的今天</text><text class="history-entry-desc data-v-a467cead">看看这一天发生过哪些大事</text></view><text class="history-entry-arrow data-v-a467cead">›</text></view><view class="detail-card card data-v-a467cead"><view class="detail-top data-v-a467cead"><view class="date-stack data-v-a467cead"><text class="detail-date data-v-a467cead">{{k}} {{l}}</text><text class="detail-lunar data-v-a467cead">农历 {{m}}{{n}} · {{o}}</text></view><view class="zodiac-badge data-v-a467cead"><text class="data-v-a467cead">{{p}}</text></view></view><view class="meta-grid data-v-a467cead"><view class="meta-item data-v-a467cead"><text class="meta-label data-v-a467cead">年柱</text><text class="meta-value data-v-a467cead">{{q}}</text></view><view class="meta-item data-v-a467cead"><text class="meta-label data-v-a467cead">月柱</text><text class="meta-value data-v-a467cead">{{r}}</text></view><view class="meta-item data-v-a467cead"><text class="meta-label data-v-a467cead">日柱</text><text class="meta-value data-v-a467cead">{{s}}</text></view></view><view wx:if="{{t}}" class="festival-line data-v-a467cead"><text wx:if="{{v}}" class="festival-tag data-v-a467cead">{{w}}</text><text wx:if="{{x}}" class="festival-tag term data-v-a467cead">{{y}}</text></view><view class="almanac-grid data-v-a467cead"><view class="almanac-panel suit-panel data-v-a467cead"><view class="almanac-title data-v-a467cead"><text class="circle good data-v-a467cead">宜</text><text class="data-v-a467cead">适合做</text></view><view class="tag-list data-v-a467cead"><text wx:for="{{z}}" wx:for-item="item" wx:key="b" class="almanac-tag good-tag data-v-a467cead">{{item.a}}</text></view></view><view class="almanac-panel avoid-panel data-v-a467cead"><view class="almanac-title data-v-a467cead"><text class="circle bad data-v-a467cead">忌</text><text class="data-v-a467cead">尽量避开</text></view><view class="tag-list data-v-a467cead"><text wx:for="{{A}}" wx:for-item="item" wx:key="b" class="almanac-tag bad-tag data-v-a467cead">{{item.a}}</text></view></view></view></view><view class="note-card card data-v-a467cead"><text class="note-title data-v-a467cead">温馨提示</text><text class="note-text data-v-a467cead">黄历宜忌基于传统民俗算法生成，仅供生活参考；重要事项请结合实际情况安排。</text></view></view></view>