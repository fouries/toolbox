<view class="{{['data-v-dae291f6', 'container', A]}}"><view class="page-shell calendar-shell data-v-dae291f6"><view class="page-header calendar-header data-v-dae291f6"><text class="title data-v-dae291f6">📅 黄历日历</text><text class="subtitle data-v-dae291f6">查看公历、农历、节气和每日宜忌</text></view><view class="calendar-card card data-v-dae291f6"><view class="calendar-toolbar data-v-dae291f6"><button class="month-btn data-v-dae291f6" size="mini" bindtap="{{a}}">‹ 上月</button><picker class="data-v-dae291f6" mode="date" value="{{d}}" bindchange="{{e}}"><view class="date-picker data-v-dae291f6"><text class="current-month data-v-dae291f6">{{b}}年{{c}}月</text><text class="picker-hint data-v-dae291f6">点击选择日期</text></view></picker><button class="month-btn data-v-dae291f6" size="mini" bindtap="{{f}}">下月 ›</button></view><view class="week-row data-v-dae291f6"><text wx:for="{{g}}" wx:for-item="week" wx:key="b" class="week-cell data-v-dae291f6">{{week.a}}</text></view><view class="month-grid data-v-dae291f6"><view wx:for="{{h}}" wx:for-item="day" wx:key="c" class="{{['day-cell', 'data-v-dae291f6', day.d && 'muted', day.e && 'today', day.f && 'selected', day.g && 'festival']}}" bindtap="{{day.h}}"><text class="solar-day data-v-dae291f6">{{day.a}}</text><text class="lunar-day data-v-dae291f6">{{day.b}}</text></view></view><button class="today-btn data-v-dae291f6" size="mini" bindtap="{{i}}">回到今天</button></view><view class="detail-card card data-v-dae291f6"><view class="detail-top data-v-dae291f6"><view class="date-stack data-v-dae291f6"><text class="detail-date data-v-dae291f6">{{j}} {{k}}</text><text class="detail-lunar data-v-dae291f6">农历 {{l}}{{m}} · {{n}}</text></view><view class="zodiac-badge data-v-dae291f6"><text class="data-v-dae291f6">{{o}}</text></view></view><view class="meta-grid data-v-dae291f6"><view class="meta-item data-v-dae291f6"><text class="meta-label data-v-dae291f6">年柱</text><text class="meta-value data-v-dae291f6">{{p}}</text></view><view class="meta-item data-v-dae291f6"><text class="meta-label data-v-dae291f6">月柱</text><text class="meta-value data-v-dae291f6">{{q}}</text></view><view class="meta-item data-v-dae291f6"><text class="meta-label data-v-dae291f6">日柱</text><text class="meta-value data-v-dae291f6">{{r}}</text></view></view><view wx:if="{{s}}" class="festival-line data-v-dae291f6"><text wx:if="{{t}}" class="festival-tag data-v-dae291f6">{{v}}</text><text wx:if="{{w}}" class="festival-tag term data-v-dae291f6">{{x}}</text></view><view class="almanac-grid data-v-dae291f6"><view class="almanac-panel suit-panel data-v-dae291f6"><view class="almanac-title data-v-dae291f6"><text class="circle good data-v-dae291f6">宜</text><text class="data-v-dae291f6">适合做</text></view><view class="tag-list data-v-dae291f6"><text wx:for="{{y}}" wx:for-item="item" wx:key="b" class="almanac-tag good-tag data-v-dae291f6">{{item.a}}</text></view></view><view class="almanac-panel avoid-panel data-v-dae291f6"><view class="almanac-title data-v-dae291f6"><text class="circle bad data-v-dae291f6">忌</text><text class="data-v-dae291f6">尽量避开</text></view><view class="tag-list data-v-dae291f6"><text wx:for="{{z}}" wx:for-item="item" wx:key="b" class="almanac-tag bad-tag data-v-dae291f6">{{item.a}}</text></view></view></view></view><view class="note-card card data-v-dae291f6"><text class="note-title data-v-dae291f6">温馨提示</text><text class="note-text data-v-dae291f6">黄历宜忌基于传统民俗算法生成，仅供生活参考；重要事项请结合实际情况安排。</text></view></view></view>