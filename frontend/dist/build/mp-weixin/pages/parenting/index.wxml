<view class="{{['container', 'data-v-9e5de5f2', D]}}"><view class="page-shell parenting-shell data-v-9e5de5f2"><view class="hero-card data-v-9e5de5f2"><text class="hero-icon data-v-9e5de5f2">👶</text><text class="title data-v-9e5de5f2">育儿工具</text><text class="subtitle data-v-9e5de5f2">覆盖孕晚期、0-1 岁、1-3 岁、3-6 岁的清单、提醒、喂养睡眠参考和成长记录</text></view><view class="card stage-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">选择阶段</text><text class="section-badge data-v-9e5de5f2">{{a}}</text></view><view class="stage-grid data-v-9e5de5f2"><view wx:for="{{b}}" wx:for-item="item" wx:key="e" class="{{['stage-item', 'data-v-9e5de5f2', item.d && 'active']}}" bindtap="{{item.f}}"><text class="stage-icon data-v-9e5de5f2">{{item.a}}</text><text class="stage-label data-v-9e5de5f2">{{item.b}}</text><text class="stage-desc data-v-9e5de5f2">{{item.c}}</text></view></view></view><view wx:if="{{c}}" class="card tools-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">孕晚期助手</text><text class="section-badge data-v-9e5de5f2">28 周+</text></view><view class="form-grid data-v-9e5de5f2"><view class="form-item data-v-9e5de5f2"><text class="form-label data-v-9e5de5f2">预产期</text><picker class="data-v-9e5de5f2" mode="date" value="{{e}}" bindchange="{{f}}"><view class="picker-box data-v-9e5de5f2">{{d}}</view></picker></view><view class="form-item data-v-9e5de5f2"><text class="form-label data-v-9e5de5f2">距离预产期</text><view class="result-pill data-v-9e5de5f2">{{g}}</view></view></view><view class="counter-box data-v-9e5de5f2"><view class="data-v-9e5de5f2"><text class="counter-title data-v-9e5de5f2">胎动计数</text><text class="counter-desc data-v-9e5de5f2">常用参考：2 小时内约 10 次；如明显减少请及时联系医生。</text></view><view class="counter-actions data-v-9e5de5f2"><button class="mini-btn data-v-9e5de5f2" bindtap="{{h}}">+1</button><button class="mini-btn ghost data-v-9e5de5f2" bindtap="{{i}}">重置</button></view><text class="counter-number data-v-9e5de5f2">{{j}} 次</text></view></view><view wx:if="{{k}}" class="card tools-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">0-1 岁喂养睡眠参考</text><text class="section-badge data-v-9e5de5f2">宝宝月龄</text></view><view class="form-grid data-v-9e5de5f2"><view class="form-item data-v-9e5de5f2"><text class="form-label data-v-9e5de5f2">宝宝月龄</text><input class="text-input data-v-9e5de5f2" type="number" placeholder="如 3" value="{{l}}" bindinput="{{m}}"/></view><view class="form-item data-v-9e5de5f2"><text class="form-label data-v-9e5de5f2">体重 kg</text><input class="text-input data-v-9e5de5f2" type="digit" placeholder="如 6.5" value="{{n}}" bindinput="{{o}}"/></view></view><view class="result-grid data-v-9e5de5f2"><view class="result-card-mini data-v-9e5de5f2"><text class="result-label data-v-9e5de5f2">奶量估算</text><text class="result-value data-v-9e5de5f2">{{p}}</text></view><view class="result-card-mini data-v-9e5de5f2"><text class="result-label data-v-9e5de5f2">睡眠参考</text><text class="result-value data-v-9e5de5f2">{{q}}</text></view></view></view><view wx:if="{{r}}" class="card tools-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">1-3 岁日常养育</text><text class="section-badge data-v-9e5de5f2">习惯建立</text></view><view class="habit-grid data-v-9e5de5f2"><view wx:for="{{s}}" wx:for-item="item" wx:key="d" class="habit-item data-v-9e5de5f2"><text class="habit-icon data-v-9e5de5f2">{{item.a}}</text><text class="habit-title data-v-9e5de5f2">{{item.b}}</text><text class="habit-desc data-v-9e5de5f2">{{item.c}}</text></view></view></view><view wx:if="{{t}}" class="card tools-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">3-6 岁入园成长</text><text class="section-badge data-v-9e5de5f2">能力准备</text></view><view class="habit-grid data-v-9e5de5f2"><view wx:for="{{v}}" wx:for-item="item" wx:key="d" class="habit-item data-v-9e5de5f2"><text class="habit-icon data-v-9e5de5f2">{{item.a}}</text><text class="habit-title data-v-9e5de5f2">{{item.b}}</text><text class="habit-desc data-v-9e5de5f2">{{item.c}}</text></view></view></view><view class="card checklist-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">阶段清单</text><text class="section-badge data-v-9e5de5f2">{{w}}/{{x}}</text></view><view class="check-list data-v-9e5de5f2"><view wx:for="{{y}}" wx:for-item="item" wx:key="d" class="check-item data-v-9e5de5f2" bindtap="{{item.e}}"><text class="{{['check-box', 'data-v-9e5de5f2', item.b && 'checked']}}">{{item.a}}</text><text class="check-text data-v-9e5de5f2">{{item.c}}</text></view></view><button class="ghost-btn data-v-9e5de5f2" bindtap="{{z}}">清空本阶段勾选</button></view><view wx:if="{{A}}" class="card vaccine-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">疫苗/体检提醒</text><text class="section-badge data-v-9e5de5f2">参考</text></view><view class="timeline-list data-v-9e5de5f2"><view wx:for="{{B}}" wx:for-item="item" wx:key="c" class="timeline-item data-v-9e5de5f2"><text class="timeline-age data-v-9e5de5f2">{{item.a}}</text><text class="timeline-text data-v-9e5de5f2">{{item.b}}</text></view></view></view><view class="card redflag-card data-v-9e5de5f2"><view class="section-title-row data-v-9e5de5f2"><text class="section-title data-v-9e5de5f2">需要及时就医/咨询的情况</text><text class="section-badge danger data-v-9e5de5f2">红旗</text></view><view class="redflag-list data-v-9e5de5f2"><text wx:for="{{C}}" wx:for-item="item" wx:key="b" class="redflag-item data-v-9e5de5f2">• {{item.a}}</text></view></view><view class="card disclaimer-card data-v-9e5de5f2"><text class="disclaimer-title data-v-9e5de5f2">温馨提示</text><text class="disclaimer-text data-v-9e5de5f2">本工具用于家庭记录和常识提醒，不替代医生诊断、产检建议、儿童保健或急诊处理；疫苗、用药、辅食和发育评估请以当地医生/社区卫生服务中心建议为准。</text></view>